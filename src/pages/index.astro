---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BookOpen, Zap, Shield, Network, ChevronRight, Brain, Coffee, AlertTriangle } from 'lucide-react';

const rfcs = await getCollection('rfcs');

const studyPlans = [
  {
    title: "Ground Truth (Or Consequences)",
    description: "The protocols that actually work. Unlike your home Wi-Fi or your sense of direction.",
    icon: Network,
    color: "bg-indigo-600",
    tracks: ["IPv4 (Legacy Junk)", "TCP (The Bureaucrat)"],
    rfc: 791
  },
  {
    title: "Encryption (For The Paranoid)",
    description: "Because Dave is definitely reading your emails. Yes, that Dave.",
    icon: Shield,
    color: "bg-rose-600",
    tracks: ["TLS 1.3 (Privacy?)", "DNS (The Snitch)"],
    rfc: 8446
  },
  {
    title: "The Snitch's Handbook",
    description: "Telemetry for people who like to point fingers at packets and cry 'Anomaly!'.",
    icon: Zap,
    color: "bg-amber-500",
    tracks: ["IPFIX (The Evidence)", "Syslog (The Confession)"],
    rfc: 9293
  }
];
---

<BaseLayout title="PROTOCOL POLICE | Internal Affairs" currentPage={{ page: 'home' }}>
	<main class="prose-container">
    <header class="mb-20 flex justify-between items-start">
      <div class="max-w-2xl">
        <div class="flex items-center gap-2 mb-6">
          <span class="bg-rose-600 text-white text-[10px] font-black px-2 py-0.5 rounded uppercase tracking-tighter">Classified</span>
          <span class="text-zinc-500 font-mono text-xs uppercase tracking-[0.3em]">Case File: 0xDEADBEEF</span>
        </div>
        <h1 class="text-7xl font-black mb-6 tracking-tighter leading-none text-white">
          PROTOCOL <span class="text-rose-600">POLICE</span>
        </h1>
        <p class="text-xl text-zinc-400 font-medium leading-relaxed max-w-xl">
          Welcome to <span class="text-white italic">Internal Affairs</span>. Since you clearly can't be trusted to read the manuals, we've broken the internet's "Ground Truth" into bite-sized chunks for your dopamine-starved brain. 
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <a href="/flashcards" class="btn-primary group">
          <Brain size={20} class="group-hover:rotate-12 transition-transform" /> Interrogate
        </a>
        <div class="text-[10px] text-zinc-500 font-mono text-right italic uppercase tracking-widest">"Compliance is mandatory."</div>
      </div>
    </header>

    <div class="bg-rose-950/20 border border-rose-900/50 p-8 rounded-3xl mb-20 flex gap-6 items-center backdrop-blur-md">
      <div class="bg-rose-600 p-3 rounded-2xl text-white shadow-[0_0_20px_rgba(225,29,72,0.4)]">
        <AlertTriangle size={32} />
      </div>
      <div>
        <h4 class="font-black text-rose-500 uppercase tracking-widest text-sm mb-1">Psychological Disclaimer</h4>
        <p class="text-sm text-zinc-400 leading-relaxed">This tool uses FSRS and ADHD-scaffolding. If you still can't remember what a SYN-ACK is, it's not the algorithm's fault. It's yours.</p>
      </div>
    </div>

    <section class="mb-24">
      <h2 class="text-2xl font-black mb-10 flex items-center gap-3 uppercase tracking-[0.2em] text-white">
        Training Curriculums
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        {studyPlans.map(plan => (
          <a href="/flashcards" class="card-evidence group block">
            <div class={`${plan.color} w-14 h-14 rounded-2xl flex items-center justify-center text-white mb-8 shadow-lg group-hover:scale-110 transition-transform`}>
              <plan.icon size={28} />
            </div>
            <h3 class="text-2xl font-black mb-3 tracking-tight text-white">{plan.title}</h3>
            <p class="text-zinc-400 mb-8 font-medium leading-snug">{plan.description}</p>
            <div class="flex flex-wrap gap-2">
              {plan.tracks.map(track => (
                <span class="tag group-hover:border-rose-900 group-hover:text-rose-500 transition-colors">{track}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="flex justify-between items-end mb-10">
        <h2 class="text-2xl font-black uppercase tracking-[0.2em] text-white">The Evidence Locker</h2>
        <div class="text-[10px] font-mono text-zinc-500 italic uppercase tracking-widest">Database: {rfcs.length} Entries</div>
      </div>
      <div class="grid gap-8">
        {rfcs.map(rfc => (
          <div class="card-evidence group relative overflow-hidden">
            <div class="absolute top-0 right-0 p-8 opacity-5 group-hover:opacity-10 transition-opacity pointer-events-none">
               <Coffee size={120} class="text-rose-600" />
            </div>
            
            <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-8">
              <div class="max-w-xl">
                <span class="text-rose-600 font-black text-xs uppercase tracking-[0.3em]">RFC-{rfc.data.number}</span>
                <h3 class="text-3xl font-black text-white mt-2 mb-3 tracking-tighter">{rfc.data.title}</h3>
                <p class="text-zinc-400 text-sm font-medium leading-relaxed">{rfc.data.description}</p>
              </div>
              
              <div class="flex flex-col sm:flex-row gap-4 shrink-0">
                <a href={`/rfc/${rfc.id}`} class="btn-secondary group/btn whitespace-nowrap">
                  <BookOpen size={18} class="group-hover/btn:text-rose-500 transition-colors" /> Read Dossier
                </a>
                <a href="/flashcards" class="btn-primary whitespace-nowrap">
                  <Brain size={18} /> Interrogate
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <footer class="mt-32 pt-12 border-t border-zinc-900 flex justify-between items-center text-zinc-600 font-mono text-[10px] uppercase tracking-[0.4em]">
       <span>Build: 6.0.4-IA</span>
       <span>Optimized for Neurodivergent Compliance</span>
       <span>© 2026 Protocol Police</span>
    </footer>
	</main>
</BaseLayout>
