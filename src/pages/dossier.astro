---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRankProgress, getUnlocks } from '../lib/progression';
import { db } from '../lib/db';
import { RANKS } from '../lib/ranks';
import { FileText, Shield, Brain, BookOpen, AlertTriangle, Lock, Unlock, Zap } from 'lucide-react';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const { rank, xp, nextRank, percentage } = getRankProgress(user.userId);
const unlocks = getUnlocks(user.userId);

// Fetch Progress Data
const rfcProgress = db.prepare('SELECT * FROM progress WHERE user_id = ?').all(user.userId) as any[];
const scenarioProgress = db.prepare('SELECT * FROM scenario_progress WHERE user_id = ?').all(user.userId) as any[];

// Get latest flashcard stats per RFC
const flashcardStats = db.prepare(`
  SELECT 
    rfc_id, 
    COUNT(DISTINCT card_id) as cards_reviewed,
    MAX(rated_at) as last_review,
    (
      SELECT rating 
      FROM flashcard_log f2 
      WHERE f2.rfc_id = f1.rfc_id AND f2.user_id = ?
      ORDER BY rated_at DESC 
      LIMIT 1
    ) as last_rating
  FROM flashcard_log f1
  WHERE user_id = ?
  GROUP BY rfc_id
`).all(user.userId, user.userId) as any[];

// Combine RFC data
const rfcMap = new Map();
for (const p of rfcProgress) {
  rfcMap.set(p.rfc_id, { ...p, cards_reviewed: 0, last_review: null, last_rating: null });
}
for (const s of flashcardStats) {
  if (rfcMap.has(s.rfc_id)) {
    rfcMap.set(s.rfc_id, { ...rfcMap.get(s.rfc_id), cards_reviewed: s.cards_reviewed, last_review: s.last_review, last_rating: s.last_rating });
  } else {
    rfcMap.set(s.rfc_id, { rfc_id: s.rfc_id, fragments_read: 0, total_fragments: 0, completed: 0, cards_reviewed: s.cards_reviewed, last_review: s.last_review, last_rating: s.last_rating });
  }
}

const allRfcStats = Array.from(rfcMap.values());

const currentRankIndex = RANKS.findIndex(r => r.id === rank.id);

// Date formatter
const formatDate = (dateStr: string) => {
  if (!dateStr) return 'UNKNOWN';
  return new Date(dateStr).toLocaleString('en-US', {
    year: 'numeric', month: 'short', day: '2-digit', 
    hour: '2-digit', minute: '2-digit', hour12: false
  }) + ' HRS';
};

const getRatingColor = (rating: string) => {
  switch (rating) {
    case 'RFC_GOD': return 'text-emerald-500';
    case 'ACCEPTABLE': return 'text-indigo-400';
    case 'SKILL_ISSUE': return 'text-amber-500';
    case 'BRAIN_ROT': return 'text-rose-500';
    default: return 'text-zinc-500';
  }
};
---

<BaseLayout title="PROTOCOL POLICE | Personnel Dossier" currentPage={{ page: 'dossier' }}>
  <main class="prose-container max-w-4xl">
    
    <header class="mb-16 border-b-4 border-rose-900/50 pb-8 relative">
      <div class="absolute top-0 right-0 p-4 border-2 border-rose-600 text-rose-600 rounded opacity-60 rotate-12 pointer-events-none select-none">
        <div class="text-2xl font-black uppercase tracking-widest">Compliance Level</div>
        <div class="text-center font-mono text-xl">{rank.title}</div>
      </div>

      <div class="flex items-center gap-2 mb-4">
        <span class="bg-rose-600 text-white text-[10px] font-black px-2 py-0.5 rounded uppercase tracking-tighter">Top Secret</span>
        <span class="text-zinc-500 font-mono text-xs uppercase tracking-[0.3em]">Eyes Only: Subject {user.callsign.toUpperCase()}</span>
      </div>
      
      <h1 class="text-6xl font-black mb-2 tracking-tighter leading-none text-white uppercase">
        Personnel Dossier
      </h1>
      <p class="text-zinc-400 font-mono text-sm tracking-widest">
        SUBJECT: {user.callsign.toUpperCase()} // STATUS: ACTIVE
      </p>
    </header>

    <section class="mb-16 card-evidence relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 opacity-5 pointer-events-none">
        <Shield size={250} />
      </div>
      
      <h2 class="text-xl font-black uppercase tracking-[0.2em] text-zinc-500 mb-6 border-b border-zinc-800 pb-2">Current Classification</h2>
      
      <div class="flex flex-col md:flex-row gap-8 items-start relative z-10">
        <div class="bg-zinc-950 p-6 rounded-2xl border border-zinc-800 flex-1">
          <div class="text-rose-500 font-black text-xs uppercase tracking-widest mb-1">Rank</div>
          <div class="text-4xl font-black text-white mb-2">{rank.title}</div>
          <p class="text-zinc-400 italic text-sm border-l-2 border-rose-600 pl-3 py-1">
            "{rank.description}"
          </p>
        </div>
        
        <div class="flex-1 w-full bg-zinc-950 p-6 rounded-2xl border border-zinc-800">
          <div class="flex justify-between items-end mb-2">
             <div class="text-zinc-400 font-black text-xs uppercase tracking-widest">Experience</div>
             <div class="text-white font-mono text-sm">{xp} XP</div>
          </div>
          
          <div class="w-full h-3 bg-zinc-900 rounded-full overflow-hidden mb-2 border border-zinc-800">
            <div 
              class="h-full bg-rose-600 transition-all duration-1000 shadow-[0_0_10px_rgba(225,29,72,0.8)]" 
              style={`width: ${percentage}%`}
            />
          </div>
          
          <div class="flex justify-between items-center text-xs font-mono">
            <span class="text-zinc-500">CURRENT</span>
            {nextRank ? (
              <span class="text-zinc-400">NEXT: {nextRank.title} ({nextRank.xp_threshold} XP)</span>
            ) : (
              <span class="text-rose-500 font-bold">MAX LEVEL REACHED</span>
            )}
          </div>
        </div>
      </div>
    </section>

    <div class="grid md:grid-cols-2 gap-8 mb-16">
      <section class="card-evidence">
         <h2 class="text-xl font-black uppercase tracking-[0.2em] text-zinc-500 mb-6 border-b border-zinc-800 pb-2">RFC Familiarity</h2>
         
         {allRfcStats.length === 0 ? (
           <div class="text-zinc-500 italic font-mono text-sm p-4 bg-zinc-950 rounded-lg border border-zinc-800/50 text-center">
             No reading records found. Ignorance is a liability.
           </div>
         ) : (
           <div class="space-y-4">
             {allRfcStats.map(stat => (
               <div class="bg-zinc-950 p-4 rounded-xl border border-zinc-800 flex flex-col gap-2">
                 <div class="flex justify-between items-center">
                   <div class="font-black text-white uppercase tracking-widest text-sm">RFC-{stat.rfc_id.replace('rfc', '')}</div>
                   {stat.completed ? (
                     <span class="text-xs bg-emerald-900/30 text-emerald-500 px-2 py-0.5 rounded font-bold border border-emerald-900">VERIFIED</span>
                   ) : (
                     <span class="text-xs bg-amber-900/30 text-amber-500 px-2 py-0.5 rounded font-bold border border-amber-900">IN PROGRESS</span>
                   )}
                 </div>
                 
                 <div class="grid grid-cols-2 gap-2 text-xs font-mono text-zinc-400">
                    <div class="bg-zinc-900 p-2 rounded flex items-center gap-2">
                      <BookOpen size={12} class="text-rose-500"/>
                      <span>Fragments: {stat.fragments_read}/{stat.total_fragments || '?'}</span>
                    </div>
                    <div class="bg-zinc-900 p-2 rounded flex items-center gap-2">
                      <Brain size={12} class="text-rose-500"/>
                      <span>Cards: {stat.cards_reviewed}</span>
                    </div>
                 </div>

                 {stat.last_rating && (
                   <div class="mt-1 text-[10px] font-mono uppercase tracking-widest flex items-center gap-2">
                     <span class="text-zinc-600">Last Performance:</span>
                     <span class={`font-black ${getRatingColor(stat.last_rating)}`}>
                       {stat.last_rating.replace('_', ' ')}
                     </span>
                   </div>
                 )}
               </div>
             ))}
           </div>
         )}
      </section>

      <section class="card-evidence">
         <h2 class="text-xl font-black uppercase tracking-[0.2em] text-zinc-500 mb-6 border-b border-zinc-800 pb-2">Scenario Analysis</h2>
         
         {scenarioProgress.length === 0 ? (
           <div class="text-zinc-500 italic font-mono text-sm p-4 bg-zinc-950 rounded-lg border border-zinc-800/50 text-center">
             No field operations recorded.
           </div>
         ) : (
           <div class="space-y-4">
             {scenarioProgress.map(stat => (
               <div class="bg-zinc-950 p-4 rounded-xl border border-zinc-800 flex flex-col gap-2">
                 <div class="flex justify-between items-center">
                   <div class="font-black text-white uppercase tracking-widest text-sm flex items-center gap-2">
                     <AlertTriangle size={14} class="text-rose-500"/> 
                     Op-{stat.scenario_id}
                   </div>
                   <span class="text-xs bg-emerald-900/30 text-emerald-500 px-2 py-0.5 rounded font-bold border border-emerald-900">CLEARED</span>
                 </div>
                 <div class="text-xs font-mono text-zinc-400 bg-zinc-900 p-2 rounded">
                   Max Score: <span class="text-white font-bold">{stat.score}</span> | Date: {formatDate(stat.completed_at)}
                 </div>
               </div>
             ))}
           </div>
         )}
      </section>
    </div>

    <section class="mb-16">
      <h2 class="text-xl font-black uppercase tracking-[0.2em] text-white mb-6 flex items-center gap-3">
        <Zap size={24} className="text-rose-500"/> Declassified Assets
      </h2>
      <div class="bg-zinc-900/50 border border-zinc-800 rounded-3xl p-6 relative overflow-hidden backdrop-blur-sm">
        {unlocks.length === 0 ? (
           <div class="text-zinc-500 italic font-mono text-sm p-4 text-center">
             No assets declassified yet. Prove your worth.
           </div>
        ) : (
          <div class="relative border-l-2 border-zinc-800 ml-4 space-y-6">
            {unlocks.map((item: any) => (
              <div class="relative pl-6">
                <div class="absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-rose-600 shadow-[0_0_10px_rgba(225,29,72,0.8)]"></div>
                <div class="text-[10px] font-mono text-zinc-500 mb-1">{formatDate(item.unlocked_at)}</div>
                <div class="bg-zinc-950 p-3 rounded-xl border border-zinc-800 inline-flex items-center gap-3">
                  {item.item_type === 'rfc' && (<FileText size={16} className="text-rose-500"/>)}
                  {item.item_type === 'scenario' && (<AlertTriangle size={16} className="text-amber-500"/>)}
                  {item.item_type === 'feature' && (<Unlock size={16} className="text-emerald-500"/>)}
                  <span class="font-bold text-white uppercase tracking-widest text-sm">
                    {item.item_type}: {item.item_id.replace('rfc', 'RFC-')}
                  </span>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="mb-20">
      <h2 class="text-xl font-black uppercase tracking-[0.2em] text-white mb-6 flex items-center gap-3">
        <Shield size={24} className="text-rose-500"/> Career Trajectory
      </h2>
      <div class="grid gap-4">
        {RANKS.map((r, index) => {
          const isUnlocked = (currentRankIndex >= index);
          const isCurrent = (index === currentRankIndex);
          
          let cardClass = "p-5 rounded-2xl border transition-all duration-300 flex flex-col md:flex-row md:items-center justify-between gap-4 ";
          if (isCurrent) cardClass += "bg-rose-950/20 border-rose-900/50 ring-1 ring-rose-500/20";
          else if (isUnlocked) cardClass += "bg-zinc-900/50 border-zinc-800";
          else cardClass += "bg-zinc-950/50 border-zinc-900 opacity-60";

          let iconClass = "w-10 h-10 rounded-xl flex items-center justify-center ";
          if (isCurrent) iconClass += "bg-rose-600 text-white";
          else if (isUnlocked) iconClass += "bg-zinc-800 text-zinc-400";
          else iconClass += "bg-zinc-900 text-zinc-700";

          return (
            <div class={cardClass}>
              <div class="flex items-center gap-4">
                <div class={iconClass}>
                  {isUnlocked ? (<Unlock size={18} />) : (<Lock size={18} />)}
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class={`text-lg font-black uppercase tracking-widest !mt-0 !mb-0 ${isUnlocked ? 'text-white' : 'text-zinc-600'}`}>
                      {isUnlocked ? r.title : 'REDACTED'}
                    </h3>
                    {isCurrent && (<span class="bg-rose-600 text-white text-[9px] px-2 py-0.5 rounded font-black tracking-widest">ACTIVE</span>)}
                  </div>
                  <p class={`text-sm mt-1 ${isUnlocked ? 'text-zinc-400' : 'text-zinc-700'}`}>
                    {isUnlocked ? r.description : 'CLASSIFIED - INSUFFICIENT CLEARANCE'}
                  </p>
                </div>
              </div>
              
              <div class="text-right shrink-0">
                <div class="text-xs font-mono font-bold text-zinc-500 uppercase tracking-widest">Threshold</div>
                <div class={isUnlocked ? 'text-white font-mono' : 'text-zinc-600 font-mono'}>{r.xp_threshold} XP</div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

  </main>
</BaseLayout>